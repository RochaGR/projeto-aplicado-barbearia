# =============================================
# Variaveis de ambiente obrigatorias
# Copie este arquivo como .env e preencha
# =============================================

# Google OAuth2 - Credenciais do Google Cloud Console
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Email - Senha de App do Gmail (gerar em: https://myaccount.google.com/apppasswords)
GOOGLE_APP_PASSWORD=sua-senha-de-app

# PostgreSQL (opcional - default: root)
SPRING_DATASOURCE_PASSWORD=root
